# Server-side only. The browser never talks to Supabase directly (see README) so no
# NEXT_PUBLIC_* Supabase vars are needed.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Local dev: run `supabase start` and copy SERVICE_ROLE_KEY from its output.
# Production: use the values from your Supabase project settings.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Simple env-secret gate for /admin in v1 (see specs/01-data-model.md and README trade-offs)
ADMIN_SECRET=
